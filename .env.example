# Backblaze B2 (required) — S3-compatible API, standardized B2_* names.
# The S3 endpoint is derived from B2_REGION as https://s3.<region>.backblazeb2.com,
# so you set the region, not a full endpoint URL.
B2_REGION=your_region
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name

# Optional: base URL for building public object links (public buckets only).
# The app runs without it; leave it commented for a private bucket.
# B2_PUBLIC_URL_BASE=https://your-bucket.s3.us-west-004.backblazeb2.com

# Example of the SHAPE of each value (illustrative placeholders, not real keys):
# B2_REGION=us-west-004
# B2_APPLICATION_KEY_ID=<keyID from the B2 dashboard>
# B2_APPLICATION_KEY=<applicationKey, shown once when you create the key>
# B2_BUCKET_NAME=my-lidar-dataset

# --- MMDetection3D engine (optional; sensible defaults) ---
# Device: auto | cpu | cuda | mps. auto picks CUDA -> CPU (CPU default). MPS is
# skipped on the auto path (mmcv/mmdet3d MPS support is weak); force mps only if
# you know your build works.
# MMDET3D_DEVICE=auto
# Root prefix for all raw scans and derived run artifacts in the bucket.
# MMDET3D_PREFIX=mmdetection3d-lidar-dataset/
# Sensor id + date the seed script writes its demo frames under (and the
# create-run form prefills).
# MMDET3D_DEMO_SENSOR=demo-sensor
# MMDET3D_DEMO_DATE=2024-01-01
# Default detection score threshold (0..1) and train/val split.
# MMDET3D_SCORE_THRESHOLD=0.3
# MMDET3D_VAL_SPLIT=0.2
# Override the resolved MMDetection3D config + checkpoint (see
# docs/features/mmdet3d-engine.md for the model zoo).
# MMDET3D_MODEL_CONFIG=
# MMDET3D_MODEL_CHECKPOINT=

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
